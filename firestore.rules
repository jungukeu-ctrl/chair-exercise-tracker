rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // users/{uid} 문서가 없는 기기(부모용 Anonymous Auth)에서도 예외 없이 빈 배열을 반환
    function allowedProfiles(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.allowedProfiles
        : [];
    }

    // profiles/{profileId} 문서가 아직 없어도 예외 없이 빈 배열을 반환
    function deviceUidsOf(profileId) {
      return exists(/databases/$(database)/documents/profiles/$(profileId))
        ? get(/databases/$(database)/documents/profiles/$(profileId)).data.deviceUids
        : [];
    }

    function isDeviceOfProfile(profileId) {
      return request.auth.uid in deviceUidsOf(profileId);
    }

    match /profiles/{profileId} {
      allow read: if isSignedIn() &&
        (profileId in allowedProfiles(request.auth.uid) || isDeviceOfProfile(profileId));
      // 기기 등록(익명 uid 추가)과 알림 설정은 해당 기기 자신만 수정 가능
      allow write: if isSignedIn() && isDeviceOfProfile(profileId);
      allow create: if isSignedIn();
    }

    match /records/{profileId}/days/{date} {
      allow read: if isSignedIn() &&
        (profileId in allowedProfiles(request.auth.uid) || isDeviceOfProfile(profileId));
      allow write: if isSignedIn() && isDeviceOfProfile(profileId);
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false; // 관리자(자녀)가 Firestore 콘솔에서 수동 설정
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // users/{uid} 문서가 없거나, 문서는 있어도 allowedProfiles 필드가 없는 경우(콘솔에서 수동 생성 등)에도
    // 예외 없이 빈 배열을 반환 — .data.allowedProfiles로 직접 접근하면 필드 부재 시 평가 오류로 거부됨
    function allowedProfiles(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get('allowedProfiles', [])
        : [];
    }

    // profiles/{profileId} 문서가 아직 없거나, 문서는 있어도 deviceUids 필드가 없는 경우(콘솔에서 수동 생성 등)에도
    // 예외 없이 빈 배열을 반환 — .data.deviceUids로 직접 접근하면 필드 부재 시 평가 오류로 거부됨
    function deviceUidsOf(profileId) {
      return exists(/databases/$(database)/documents/profiles/$(profileId))
        ? get(/databases/$(database)/documents/profiles/$(profileId)).data.get('deviceUids', [])
        : [];
    }

    function isDeviceOfProfile(profileId) {
      return request.auth.uid in deviceUidsOf(profileId);
    }

    // users/{uid} 문서가 없으면 null 반환
    function userRole(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : null;
    }

    // 자녀 계정(role == "child")이면서 해당 profileId를 열람 권한으로 가진 경우
    function isChildOf(profileId) {
      return userRole(request.auth.uid) == "child" && profileId in allowedProfiles(request.auth.uid);
    }

    // 자녀 계정이 "기기 등록 초기화" 버튼으로 deviceUids만 빈 배열로 재설정하는 경우
    function isChildDeviceReset(profileId) {
      let existingData = resource != null ? resource.data : {};
      return isChildOf(profileId) &&
        request.resource.data.diff(existingData).affectedKeys().hasOnly(["deviceUids"]) &&
        request.resource.data.deviceUids.size() == 0;
    }

    // 미등록 기기가 자기 uid 하나만 deviceUids에 추가하는 자가 등록(최대 2대)인지 확인.
    // name/deviceUids 외 필드 변경이나 다른 기기 제거는 허용하지 않음.
    function isSelfDeviceRegistration(profileId) {
      let before = deviceUidsOf(profileId);
      let after = request.resource.data.deviceUids;
      let existingData = resource != null ? resource.data : {};
      return request.resource.data.diff(existingData).affectedKeys().hasOnly(["name", "deviceUids"]) &&
        after.hasAll(before) &&
        after.size() == before.size() + 1 &&
        after.removeAll(before).hasOnly([request.auth.uid]) &&
        after.size() <= 2;
    }

    match /profiles/{profileId} {
      allow read: if isSignedIn() &&
        (profileId in allowedProfiles(request.auth.uid) || isDeviceOfProfile(profileId));
      // 이미 등록된 기기는 자유롭게 수정 가능, 미등록 기기는 자가 등록만 허용, 자녀 계정은 기기 등록 초기화만 허용
      allow write: if isSignedIn() &&
        (isDeviceOfProfile(profileId) || isSelfDeviceRegistration(profileId) || isChildDeviceReset(profileId));
    }

    match /records/{profileId}/days/{date} {
      allow read: if isSignedIn() &&
        (profileId in allowedProfiles(request.auth.uid) || isDeviceOfProfile(profileId));
      allow write: if isSignedIn() && isDeviceOfProfile(profileId);
      // 자녀 계정의 "기록 데이터 초기화" 버튼 전용 삭제 허용 (부모 기기 쓰기 권한과 별개)
      allow delete: if isSignedIn() && isChildOf(profileId);
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false; // 관리자(자녀)가 Firestore 콘솔에서 수동 설정
    }
  }
}
